<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Converter</AssemblyName>
    <AssemblyTitle>Converter</AssemblyTitle>
    <RootNamespace>Converter</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="Avalonia">
    <AvaloniaXamlIlDebuggerLaunch>False</AvaloniaXamlIlDebuggerLaunch>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SignAssembly>False</SignAssembly>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia" Condition="('$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64')">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia" Condition="('$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x86')">
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>true</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia" Condition="('$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-arm64')">
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>true</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
	 <PackageReference Include="Avalonia" Version="12.1.1" />
	 <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
	 <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
	 <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
     <PackageReference Include="CliWrap" Version="3.10.5" />
	 <PackageReference Include="LibVLCSharp" Version="3.10.1" />
	 <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
	 <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	 <PackageReference Include="SkiaSharp" Version="4.151.1" />
	 <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
	 <PackageReference Include="System.Diagnostics.Process" Version="4.3.0" />
	 <PackageReference Include="System.Xml.Linq" Version="3.5.21022.801" />
	 <PackageReference Include="Velopack" Version="1.2.0" />
     <PackageReference Include="LibVLC.Linux" Version="1.0.0.15" />
	 <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
	 <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="$([MSBuild]::IsOSPlatform('MacOS'))" />
	 <PackageReference Include="Downloader" Version="5.9.5" />
	 <PackageReference Include="PopUpWindow" Version="1.0.10.86" />
	 <PackageReference Include="BergamotTranslatorSharp" Version="0.5.1" />
	 <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
</Project>
